# Names only. Never put real values in this file or commit a filled-in copy.
# Copy to .env.local for local development (git-ignored). Production values live only in
# Vercel project env vars; backup secrets live only in GitHub Actions secrets.

# --- Required (the app refuses to start without these) ---

# Neon Postgres connection string (postgres://... with ?sslmode=require).
DATABASE_URL=
# Stockkart backend (inventory-api) base URL WITHOUT /api/v1. https only (http allowed for localhost).
STOCKKART_API_URL=
# Auth.js session encryption secret, >= 32 random bytes. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Optional ---

# Public URL of this app. Not needed on Vercel. Needed for `next start` outside Vercel,
# e.g. local production builds and Playwright.
AUTH_URL=

# Development aid: set to 1 to log database round trips per request (counts and ms only).
HQ_LOG_QUERIES=

# --- Later phases (unused in Phase 0) ---

# Cloudflare R2 private bucket for attachments and backups (Phase 2 / backups).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# HMAC secret for the GitHub org webhook (Phase 2, GH-1).
GITHUB_WEBHOOK_SECRET=
